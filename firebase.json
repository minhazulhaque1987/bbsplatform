{
  "database": {
    "rules": {
      "users": {
        ".read": true,
        ".write": true,
        "$uid": {
          ".validate": "newData.hasChildren(['name', 'email', 'status', 'password', 'userId', 'office', 'post'])"
        }
      },
      "phc2022": {
        ".read": true,
        ".write": true,
        "upazilas": {
          "$upazilaId": {
            ".validate": "newData.hasChildren(['name', 'total_population', 'literacy_rate'])"
          }
        }
      },
      "cropCalendar": {
        ".read": true,
        ".write": true,
        "reports": {
          "$reportId": {
            ".validate": "newData.hasChildren(['name', 'status', 'deadline'])"
          }
        }
      }
    }
  }
}